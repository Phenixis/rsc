{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking that main only changes through pull requests..."
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/docs-before-push.sh",
            "timeout": 10,
            "statusMessage": "Checking the documentation is up to date..."
          }
        ]
      }
    ]
  }
}
